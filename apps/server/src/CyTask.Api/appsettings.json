{
  "CyTask": {
    "ApplyMigrations": false,
    "UseInMemoryStore": false,
    "LocalMode": false,
    "DataEncryptionEnabled": false,
    "LocalSyncSeconds": 2,
    "SessionHours": 12,
    "MfaPolicy": "disabled",
    "MfaAuthenticatorEnabled": true,
    "MfaEmailEnabled": false,
    "MfaIssuer": "CyTask",
    "SmtpPort": 587,
    "SmtpSecurity": "StartTls",
    "InvitationHours": 72,
    "MaxRequestBodyBytes": 5242880,
    "MaxAttachmentBytes": 2147483648,
    "UploadChunkBytes": 4194304,
    "UploadHours": 24,
    "MediaStoragePath": ".data/media",
    "OutboxPollMilliseconds": 250,
    "OutboxBatchSize": 64,
    "OutboxLeaseSeconds": 30,
    "OutboxRetentionDays": 7,
    "EventReplayBatchSize": 256,
    "SseHeartbeatSeconds": 15,
    "WebRtcStunUrls": [],
    "WebRtcTurnUrls": [],
    "WebRtcTurnCredentialSeconds": 3600,
    "WebRtcRelayOnly": false,
    "CallMaxParticipants": 8,
    "CallAccessCheckSeconds": 15,
    "AiLocalAgentsEnabled": false,
    "AiAllowPrivateEndpoints": false,
    "AiRequestTimeoutSeconds": 120,
    "AiMaxOutputCharacters": 50000,
    "CyAnnotaUrl": "/plugins/cyannota/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
