{
  "CyTask": {
    "ApplyMigrations": false,
    "UseInMemoryStore": false,
    "SessionHours": 12,
    "InvitationHours": 72,
    "MaxRequestBodyBytes": 5242880,
    "MaxAttachmentBytes": 2147483648,
    "UploadChunkBytes": 4194304,
    "UploadHours": 24,
    "MediaStoragePath": ".data/media",
    "OutboxPollMilliseconds": 250,
    "OutboxBatchSize": 64,
    "OutboxLeaseSeconds": 30,
    "OutboxRetentionDays": 7,
    "EventReplayBatchSize": 256,
    "SseHeartbeatSeconds": 15,
    "AiLocalAgentsEnabled": false,
    "AiAllowPrivateEndpoints": false,
    "AiRequestTimeoutSeconds": 120,
    "AiMaxOutputCharacters": 50000,
    "CyAnnotaUrl": "/plugins/cyannota/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
