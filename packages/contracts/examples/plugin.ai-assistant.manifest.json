{
  "schemaVersion": 1,
  "id": "dev.cytask.ai-assistant",
  "name": "AI Assistant",
  "description": "Connecte les tickets à OpenAI, Anthropic, Ollama, LM Studio, Codex, Claude Code, OpenCode ou une API compatible.",
  "version": "0.2.0",
  "apiVersion": "v1",
  "runtime": "service-connector",
  "entrypoints": {
    "service": "CyTask.Plugin.AiAssistant",
    "web": "builtin:ai-assistant"
  },
  "permissions": ["tasks:read", "tasks:plugin-data:write", "ai:invoke", "secrets:encrypted"],
  "contributes": {
    "taskTabs": [{
      "id": "assistant",
      "title": "AI Assistant",
      "icon": "AI",
      "fields": [
        { "key": "connectionId", "label": "Connexion IA", "type": "text", "maxLength": 64 },
        { "key": "goal", "label": "Objectif de l’assistant", "type": "textarea", "maxLength": 12000 },
        { "key": "includeComments", "label": "Inclure les commentaires", "type": "boolean" },
        { "key": "outputMode", "label": "Sortie attendue", "type": "select", "options": ["Plan", "Résumé", "Checklist", "Commentaire", "Revue technique"] },
        { "key": "instructions", "label": "Instructions de l’équipe", "type": "textarea", "maxLength": 12000 },
        { "key": "lastSummary", "label": "Dernière réponse conservée", "type": "textarea", "maxLength": 50000 }
      ]
    }]
  },
  "minimumCyTaskVersion": "0.2.0",
  "homepage": "https://github.com/MrMybal/CyTask"
}