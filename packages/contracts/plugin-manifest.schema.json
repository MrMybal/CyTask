{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cytask.dev/schemas/plugin-manifest-v1.json",
  "title": "CyTask Plugin Manifest",
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "type"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,63}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "type": {
          "type": "string",
          "enum": ["text", "textarea", "number", "boolean", "select", "asset-path", "map-path", "string-list"]
        },
        "required": { "type": "boolean", "default": false },
        "description": { "type": "string", "maxLength": 500 },
        "placeholder": { "type": "string", "maxLength": 500 },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 20000 },
        "options": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      }
    },
    "taskTab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "icon", "fields"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 40 },
        "icon": { "type": "string", "minLength": 1, "maxLength": 4 },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/field" }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "apiVersion",
    "runtime",
    "entrypoints",
    "permissions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$",
      "maxLength": 128
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 500 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "apiVersion": { "type": "string", "pattern": "^v[1-9][0-9]*$" },
    "runtime": {
      "type": "string",
      "enum": ["sandbox", "service-connector", "ui-extension"]
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 },
      "minProperties": 1
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*)+$"
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskTabs"],
      "properties": {
        "taskTabs": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/taskTab" }
        }
      }
    },
    "networkAllowlist": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "hostname" }
    },
    "minimumCyTaskVersion": { "type": "string" },
    "homepage": { "type": "string", "format": "uri" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "runtime": { "const": "service-connector" } },
        "required": ["runtime"]
      },
      "then": {},
      "else": {
        "not": { "required": ["networkAllowlist"] }
      }
    }
  ]
}
