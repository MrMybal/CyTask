# Utilisez une valeur longue et aléatoire. Ne versionnez jamais le fichier .env réel.
CYTASK_DB_PASSWORD=changez-cette-valeur-avec-au-moins-32-caracteres
CYTASK_HTTP_PORT=8080
CYTASK_ALLOWED_HOSTS=localhost;127.0.0.1
# HTTPS origin served by your TLS proxy, for example https://cytask.example.invalid
CYTASK_PUBLIC_ORIGIN=
CYTASK_CYANNOTA_URL=/plugins/cyannota/
# Optional content encryption at rest. Use a separate random base64 key (32 bytes).
# Existing content requires the documented OFFLINE conversion command.
CYTASK_DATA_ENCRYPTION_ENABLED=false
CYTASK_DATA_ENCRYPTION_KEY=
# disabled, optional, required. Persistent MFA needs a separate random base64 key (32 bytes).
CYTASK_MFA_POLICY=disabled
CYTASK_MFA_AUTHENTICATOR_ENABLED=true
CYTASK_MFA_EMAIL_ENABLED=false
CYTASK_MFA_ENCRYPTION_KEY=
CYTASK_SMTP_HOST=
CYTASK_SMTP_PORT=587
CYTASK_SMTP_SECURITY=StartTls
CYTASK_SMTP_FROM=
CYTASK_SMTP_USERNAME=
CYTASK_SMTP_PASSWORD=
